HOST=0.0.0.0
PORT=8080

RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
RPC_URL_BASE=https://mainnet.base.org
SIGNER_TYPE=private-key
EVM_PRIVATE_KEY=0xdeadbeef

# Honeycomb OpenTelemetry
#OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io:443
#OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=your_api_key,x-honeycomb-dataset=x402-rs
#OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Solana compute budget limits (optional, defaults applied if unset)
# Format: X402_SOLANA_MAX_COMPUTE_UNIT_LIMIT_<NETWORK>
X402_SOLANA_MAX_COMPUTE_UNIT_LIMIT_SOLANA=400000
X402_SOLANA_MAX_COMPUTE_UNIT_LIMIT_SOLANA_DEVNET=200000

# Solana compute unit price in microlamports (optional)
# Format: X402_SOLANA_MAX_COMPUTE_UNIT_PRICE_<NETWORK>
X402_SOLANA_MAX_COMPUTE_UNIT_PRICE_SOLANA=1000000
X402_SOLANA_MAX_COMPUTE_UNIT_PRICE_SOLANA_DEVNET=100000

# Payment validation settings (optional)
# Comma-separated list of allowed recipient addresses for EIP-3009 transfers
# If set, only these addresses can receive payments
# Example: ALLOWED_RECIPIENTS=0x1234...abc,0x5678...def
#ALLOWED_RECIPIENTS=

# Comma-separated list of disallowed recipient addresses for EIP-3009 transfers
# If set, these addresses cannot receive payments
# Example: DISALLOWED_RECIPIENTS=0x1234...abc,0x5678...def
#DISALLOWED_RECIPIENTS=

# Minimum USDC amount in wei units (6 decimals)
# Example: MIN_USDC=10000 (= 0.01 USDC)
#MIN_USDC=

# Transaction confirmation mode (optional)
# Default: 0 (preconfirmation mode for Flashblocks-enabled RPCs like Alchemy)
# Set to 1 for traditional 1-block confirmation (~2s on Base)
# With preconfirmations (TX_CONFIRMATIONS=0), settlement returns in ~200ms
#TX_CONFIRMATIONS=0
